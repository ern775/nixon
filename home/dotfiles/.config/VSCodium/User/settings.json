{
    "nix.serverPath": "nixd",
    "nix.enableLanguageServer": true,
    "nix.serverSettings": {
        "nixd": {
            "formatting": {
                "command": [
                    "nixfmt"
                ],
            },
            "options": {
                "nixos": {
                    "expr": "(builtins.getFlake \"/home/eren/system\").nixosConfigurations.nixos.options",
                },
                "home_manager": {
                    "expr": "(builtins.getFlake \"/home/eren/system\").homeConfigurations.\"eren\".options",
                },
            },
        },
    },
    "explorer.confirmDelete": false,
    "nix.formatterPath": "nixfmt",
    "nix.hiddenLanguageServerErrors": [
        "textDocument/definition",
    ],
    "editor.minimap.enabled": false,
    "explorer.confirmDragAndDrop": false,
    "security.workspace.trust.untrustedFiles": "open",
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "python.autoComplete.extraPaths": [],
    "[dart]": {
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.rulers": [
            80
        ],
        "editor.selectionHighlight": false,
        "editor.tabCompletion": "onlySnippets",
        "editor.wordBasedSuggestions": "off"
    },
    "direnv.watchForChanges": false,
    "direnv.restart.automatic": true,
    "nixEnvSelector.useFlakes": true,
    "python.terminal.launchArgs": [],
    "workbench.startupEditor": "none",
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false,
    "editor.formatOnType": false,
    "qt-core.additionalQtPaths": [
        {
            "name": "Qt-6.10.1-linux-g++_from_PATH",
            "path": "/nix/store/kavwy4v9p1jhf952dzipkjj5l1hjx110-qtbase-6.10.1/bin/qtpaths"
        },
        {
            "name": "Qt-6.8.3-linux-g++_from_PATH",
            "path": "/nix/store/n1zfyp02c6r5rd24phcj38jjah3zgdaj-qtbase-6.8.3/bin/qtpaths"
        }
    ],
    "editor.unicodeHighlight.ambiguousCharacters": false,
}