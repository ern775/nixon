-- ################
-- ### MONITORS ###
-- ################

-- See https://wiki.hypr.land/Configuring/Monitors/
-- monitor=,preferred,auto,auto
-- monitor = , highres, auto, 1

hl.monitor({
    output   = "eDP-1",
    mode     = "preferred",
    position = "auto",
    bitdepth = 10,
    scale    = 1,
    cm       = "auto",
    icc      = "/home/eren/.config/color/icc/devices/display/Victus15.icm"
})

hl.monitor({
    output   = "HDMI-A-1",
    mode     = "1920x1080@60",
    position = "auto-right",
    scale    = "auto",
    mirror   = "eDP-1"
})

hl.config({
    render = {
        -- use_fp16 = 1,
        -- keep_unmodified_copy = 1,
        -- non_shader_cm = 1,
        -- direct_scanout = 2,
    },
    cursor = {
        no_hardware_cursors = false
    }
})

-- ###################
-- ### MY PROGRAMS ###
-- ###################

-- See https://wiki.hypr.land/Configuring/Keywords/

-- Set programs that you use
local terminal = "kitty"
local fileManager = "dolphin"

-- #################
-- ### AUTOSTART ###
-- #################

-- Autostart necessary processes (like notifications daemons, status bars, etc.)
-- Or execute your favorite apps at launch like this:

hl.on("hyprland.start", function()
    -- hl.exec_cmd("nm-applet &")
    -- hl.exec_cmd("waybar & hyprpaper")
    hl.exec_cmd("dbus-update-activation-environment --systemd --all")
    -- hl.exec_cmd("noctalia-shell")
    hl.exec_cmd("noctalia-shell")
    -- hl.exec_cmd("systemctl --user start hyprpolkitagent")
    hl.exec_cmd(
        "systemd-inhibit --who=\"Hyprland config\" --why=\"wlogout keybind\" --what=handle-power-key --mode=block sleep infinity & echo $! > /tmp/.hyprland-systemd-inhibit")
    hl.exec_cmd("zapzap")
    hl.exec_cmd("udiskie")
    -- hl.exec_cmd("hypridle")
    -- hl.exec_cmd("dbus-update-activation-environment --systemd DISPLAY HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE && systemctl --user stop hyprland-session.target && systemctl --user start hyprland-session.target")
end)


-- #############################
-- ### ENVIRONMENT VARIABLES ###
-- #############################

-- See https://wiki.hypr.land/Configuring/Environment-variables/

hl.env("XCURSOR_SIZE", "20")
hl.env("HYPRCURSOR_SIZE", "20")

hl.env("AQ_DRM_DEVICES", "/dev/dri/intel-igpu:/dev/dri/nvidia-gpu")

hl.env("GDK_SCALE", "1")
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")

hl.env("QT_QPA_PLATFORM", "wayland")
hl.env("QT_QPA_PLATFORMTHEME", "kde")
hl.env("XDG_SCREENSHOTS_DIR", "$HOME/Pictures/Screenshots")

